{
  "name": "bakim-takip",
  "version": "1.3.0",
  "description": "Araç Bakım Takip Uygulaması",
  "author": "Ceyhan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --config.directories.output=$HOME/dist-bakim-takip"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.bakim.takip",
    "productName": "Bakım Takip",
    "icon": "build/icon",
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities", "icon": "build/icon.icns" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}